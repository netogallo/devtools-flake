USER { llm-netogallo, lib, pkgs, ... }:
USER let
USER   run-llm-application = name: { working-directory, task-branch-prefix, ... }:
USER   let
USER     is-enabled = if task-branch-prefix == null then "false &&" else "true &&";
USER     task-preamble = pkgs.writeText "task-preamble" ''
USER       The user is working on a task which has been defined in '$TASK_FILE'. This
USER       file will be read into the context for your reference. Your job is
USER       to assist the user with any request related tho the task.
USER     '';
USER   in
USER     pkgs.writeShellApplication {
USER       inherit name;
USER       runtimeInputs = with pkgs; [ git aider-chat nano gettext docopts ];
USER       text = ''
USER         set -ue -o pipefail
USER         docopts -h - : <<'DOCOPTS'
USER         llm-netogallo: A tool to organize workflows with LLM assistance
USER         Usage:
USER           llm-netogallo [--new-task] [--aider-args=<args>...]
USER           llm-netogallo [-h] [--help]
USER         Options:
USER           --new-task       Start a new task.
USER           --aider-args=<args>  Arguments to pass to aider.
USER           -h, --help       Show this help.
USER         DOCOPTS
USER 
USER         CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
USER 
USER         # Check if we are not in a task branch. Launch aider
USER         # normally in that case
USER         if ${is-enabled} [[ "$CURRENT_BRANCH" != "${task-branch-prefix}"* ]]; then
USER         	aider "$@"
USER         	exit 0
USER         fi
USER         
USER         LLM_DIR="journal/$CURRENT_BRANCH"
USER         mkdir -p "$LLM_DIR"
USER 
USER         # The session dir is meant to be used to store
USER         # the chat history with the LLM
USER         LLM_SESSION_CONTEXT_DIR="$LLM_DIR/session-contexts"
USER         mkdir -p "$LLM_SESSION_CONTEXT_DIR"
USER 
USER         LLM_TASKS_DIR="$LLM_DIR/tasks"
USER         mkdir -p "$LLM_TASKS_DIR"
USER 
USER         LLM_CONTROL_DIR="$LLM_DIR/control"
USER         mkdir -p "$LLM_CONTROL_DIR"
USER 
USER         LLM_CURRENT_TASK_FILE="$LLM_CONTROL_DIR/current_task.txt"
USER 
USER         if [[ ! -f "$LLM_CURRENT_TASK_FILE" ]]; then
USER           read -rp "Starting a new task. What is the task name? " task_name
USER           echo "$task_name" > "$LLM_CURRENT_TASK_FILE"
USER         fi
USER 
USER         LLM_TASK=$(cat "$LLM_CURRENT_TASK_FILE")
USER         LLM_ACTIVE_TASK_FILE="$LLM_TASKS_DIR/$LLM_TASK"
USER 
USER         if [[ ! -f "$LLM_ACTIVE_TASK_FILE" ]]; then
USER           echo "Describe the task $task_name here..." > "$LLM_ACTIVE_TASK_FILE"
USER           nano "$LLM_ACTIVE_TASK_FILE"
USER         fi
USER 
USER         mkdir -p "$LLM_SESSION_CONTEXT_DIR/$LLM_TASK"
USER         TASK_INPUT_FILE=$(mktemp)
USER 
USER         cat "${task-preamble}" \
USER           | (TASK_FILE="$LLM_ACTIVE_TASK_FILE" envsubst) \
USER           > "$TASK_INPUT_FILE"
USER         
USER         aider \
USER           --read "$TASK_INPUT_FILE" \
USER           --read "$LLM_ACTIVE_TASK_FILE" \
USER         	--llm-history-file "$LLM_SESSION_CONTEXT_DIR/$LLM_TASK/llm.history" \
USER         	--chat-history-file "$LLM_SESSION_CONTEXT_DIR/$LLM_TASK/session.md" "$@"
USER       '';
USER     }
USER   ;
USER   to-llm-app = name: spec:
USER   let
USER     application = run-llm-application name spec;
USER   in 
USER     {
USER       name = "devtools/${name}";
USER       value = {
USER         type = "app";
USER         program = "${application}/bin/${application.NIX_MAIN_PROGRAM}";
USER       };
USER     }
USER   ;
USER in
USER   {
USER     apps = lib.mapAttrs' to-llm-app llm-netogallo;
USER   }
USER ```
