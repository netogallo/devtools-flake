USER llm-netogallo/config.nix
USER ```
USER /** This file holds the flake configuration spec for the
USER *   'llm-netogallo' mode for Aider. This mode provides the
USER *   following:
USER *   - Divide your workflow in tasks.
USER *   - Save the conversation with the LLM within your repository,
USER *     organized by task.
USER *   - The saved conversations can then be used to further generate
USER *     content. As an example, a technical report can easily be
USER *     generated from that material describing what was implemented.
USER */
USER { self, lib, config, flake-parts-lib, ... }:
USER let
USER   inherit (lib) types mkOption;
USER   inherit (flake-parts-lib) mkPerSystemOption;
USER   flake-config = config;
USER   llm-netogallo-spec = types.submodule {
USER     options = {
USER       enable = mkOption {
USER         type = types.bool;
USER         description = ''
USER           Enable this tool for a particular name.
USER         '';
USER         default = false;
USER       };
USER       working-directory = mkOption {
USER         type = types.str;
USER         description = ''
USER           The working directory. If specified as relative,
USER           it will be relative to the CWD where the llm tool
USER           is launched. This directory will be used for the
USER           following pruposes:
USER             * Store the llm context/history
USER             * Store the chat history with the llm
USER             * Store information about the current task
USER         '';
USER         default = "journal";
USER       };
USER       task-branch-prefix = mkOption {
USER         type = types.nullOr types.str;
USER         description = ''
USER           The prefix in the name of the git branch that activates
USER           the 'task mode' of the llm tool. When working in 'task'
USER           mode, the conversation with the llm will be saved to
USER           the working directory and the task description will
USER           be injected to the llm context.
USER         '';
USER         default = null;
USER       };
USER     };
USER   };
USER   perSystem = { pkgs, ... }:
USER   let
USER     inherit (
USER       pkgs.callPackage
USER       ./setup.nix
USER       { inherit (flake-config.development-tools) llm-netogallo; }
USER     ) apps;
USER   in
USER     { config = { inherit apps; }; }
USER   ;
USER in
USER   {
USER     options = {
USER       development-tools.llm-netogallo = mkOption {
USER         type = types.attrsOf llm-netogallo-spec;
USER         description = ''
USER           This allows configuring the aider llm programming
USER           tool with the setup used by netogallo. Each value
USER           will become an individual configuration.
USER         '';
USER         default = {};
USER       };
USER       perSystem = mkPerSystemOption perSystem;
USER     };
USER   }
USER ```
USER 
USER flake.nix
USER ```
USER {
USER   description = "A Nix flake module I use to configure my editor for my projects.";
USER 
USER   inputs = {
USER     flake-parts.url = "github:hercules-ci/flake-parts";
USER     nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
USER   };
USER 
USER   outputs = inputs@{ flake-parts, nixpkgs, ... }:
USER     flake-parts.lib.mkFlake { inherit inputs; } ({ flake-parts-lib, ... }: {
USER       imports = [
USER         ./flakeModule.nix
USER         # To import an internal flake module: ./other.nix
USER         # To import an external flake module:
USER         #   1. Add foo to inputs
USER         #   2. Add foo as a parameter to the outputs function
USER         #   3. Add here: foo.flakeModule
USER       ];
USER       systems = [ "x86_64-linux" "aarch64-linux" "aarch64-darwin" "x86_64-darwin" ];
USER       perSystem = { config, self', inputs', pkgs, system, ... }: {
USER         # Per-system attributes can be defined here. The self' and inputs'
USER         # module parameters provide easy access to attributes of the same
USER         # system.
USER       };
USER       flake = flake-parts.lib.mkFlake { inherit inputs; } {
USER         imports = [
USER           ./flakeModule.nix
USER           ./examples/flakeModule.nix
USER         ];
USER         systems = [ "x86_64-linux" "aarch64-linux" "aarch64-darwin" "x86_64-darwin" ];
USER         # The usual flake attributes can be defined here, including system-
USER         # agnostic ones like nixosModule and system-enumerating ones, although
USER         # those are more easily expressed in perSystem.
USER         flake = {
USER           flakeModules.default = ./flakeModule.nix;
USER         };
USER       };
USER     });
USER }
USER ```
USER 
USER llm-netogallo/setup.nix
USER ```
USER { llm-netogallo, lib, pkgs, ... }:
USER let
USER   run-llm-application = name: { working-directory, task-branch-prefix, ... }:
USER   let
USER     is-enabled = if task-branch-prefix == null then "false &&" else "true &&";
USER     task-preamble = pkgs.writeText "task-preamble" ''
USER       The user is working on a task which has been defined in '$TASK_FILE'. This
USER       file will be read into the context for your reference. Your job is
USER       to assist the user with any request related tho the task.
USER     '';
USER   in
USER     pkgs.writeShellApplication {
USER       inherit name;
USER       runtimeInputs = with pkgs; [ git aider-chat nano gettext docopts ];
USER       text = ''
USER         set -xue -o pipefail
USER         new_task=false
USER         aider_args=()
USER         eval "$(docopts -h - : "$@" <<DOCOPTS
USER         [PROGRAM]: A tool to organize workflows with LLM assistance
USER         Usage:
USER           [PROGRAM] [--new-task] [--aider-args=<args>...]
USER           [PROGRAM] (-h | --help)
USER         Options:
USER           --new-task       Start a new task.
USER           --aider-args=<args>  Arguments to pass to aider.
USER           -h, --help       Show this help.
USER         DOCOPTS
USER         )"
USER 
USER         CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
USER 
USER         # Check if we are not in a task branch. Launch aider
USER         # normally in that case
USER         if ${is-enabled} [[ "$CURRENT_BRANCH" != "${task-branch-prefix}"* ]]; then
USER         	aider "$@"
USER         	exit 0
USER         fi
USER         
USER         LLM_DIR="journal/$CURRENT_BRANCH"
USER         mkdir -p "$LLM_DIR"
USER 
USER         # The session dir is meant to be used to store
USER         # the chat history with the LLM
USER         LLM_SESSION_CONTEXT_DIR="$LLM_DIR/session-contexts"
USER         mkdir -p "$LLM_SESSION_CONTEXT_DIR"
USER 
USER         LLM_TASKS_DIR="$LLM_DIR/tasks"
USER         mkdir -p "$LLM_TASKS_DIR"
USER 
USER         LLM_CONTROL_DIR="$LLM_DIR/control"
USER         mkdir -p "$LLM_CONTROL_DIR"
USER 
USER         LLM_CURRENT_TASK_FILE="$LLM_CONTROL_DIR/current_task.txt"
USER 
USER         if [[ ! -f "$LLM_CURRENT_TASK_FILE" || "$new_task" == "true" ]]; then
USER           read -rp "Starting a new task. What is the task name? " task_name
USER           echo "$task_name" > "$LLM_CURRENT_TASK_FILE"
USER         fi
USER 
USER         LLM_TASK=$(cat "$LLM_CURRENT_TASK_FILE")
USER         LLM_ACTIVE_TASK_FILE="$LLM_TASKS_DIR/$LLM_TASK"
USER 
USER         if [[ ! -f "$LLM_ACTIVE_TASK_FILE" ]]; then
USER           echo "Describe the task $task_name here..." > "$LLM_ACTIVE_TASK_FILE"
USER           nano "$LLM_ACTIVE_TASK_FILE"
USER         fi
USER 
USER         mkdir -p "$LLM_SESSION_CONTEXT_DIR/$LLM_TASK"
USER         TASK_INPUT_FILE=$(mktemp)
USER 
USER         cat "${task-preamble}" \
USER           | (TASK_FILE="$LLM_ACTIVE_TASK_FILE" envsubst) \
USER           > "$TASK_INPUT_FILE"
USER         
USER         aider \
USER           --read "$TASK_INPUT_FILE" \
USER           --read "$LLM_ACTIVE_TASK_FILE" \
USER         	--llm-history-file "$LLM_SESSION_CONTEXT_DIR/$LLM_TASK/llm.history" \
USER         	--chat-history-file "$LLM_SESSION_CONTEXT_DIR/$LLM_TASK/session.md" "''${aider_args[@]}"
USER       '';
USER     }
USER   ;
USER   to-llm-app = name: spec:
USER   let
USER     application = run-llm-application name spec;
USER   in 
USER     {
USER       name = "devtools/${name}";
USER       value = {
USER         type = "app";
USER         program = "${application}/bin/${application.NIX_MAIN_PROGRAM}";
USER       };
USER     }
USER   ;
USER in
USER   {
USER     apps = lib.mapAttrs' to-llm-app llm-netogallo;
USER   }
USER ```
