ASSISTANT 
ASSISTANT ```nix
ASSISTANT /**
ASSISTANT This module is responsible for generating all the flake attributes
ASSISTANT that result from a lite-llm configuration. Multiple named lite-llm
ASSISTANT configurations can be present in a flake, each will result in
ASSISTANT a separate set of attributes in the flake.
ASSISTANT */
ASSISTANT { pkgs, lib, devtools-prelude, lite-llm-name, lite-llm, ... }:
ASSISTANT let
ASSISTANT   /**
ASSISTANT   Contains llm provider specific parameters
ASSISTANT   that are used to build the lite-llm configuration.
ASSISTANT   This includes:
ASSISTANT     - api_key: The provider API key. For security reasons, the
ASSISTANT       key is not saved to the nix store. Instead each provider
ASSISTANT       will read it from a specific environmental variable.
ASSISTANT       When the lite-llm instance is launched, theese variables
ASSISTANT       will be set by reading the keys from a private directory.
ASSISTANT   */
ASSISTANT   provider-params = {
ASSISTANT     openrouter = rec {
ASSISTANT       key-env-name = "OPENROUTER_API_KEY";
ASSISTANT       api_key = "os.environ/${key-env-name}";
ASSISTANT     };
ASSISTANT   };
ASSISTANT 
ASSISTANT   get-provider-params = model:
ASSISTANT   let
ASSISTANT     parts = lib.strings.splitString "/" model;
ASSISTANT     provider = lib.elemAt parts 0;
ASSISTANT   in
ASSISTANT     if lib.hasAttr provider provider-params
ASSISTANT     then provider-params.${provider}
ASSISTANT     else throw "Unsupported model provider '${provider}'"
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT   Create an attribute set matching the configuration that
ASSISTANT   lite-llm expects for each model definition.
ASSISTANT   */
ASSISTANT   to-model-config = model-name: { model, ... }:
ASSISTANT   let
ASSISTANT     provider-params = get-provider-params model;
ASSISTANT     provider-config = { inherit (provider-params) api_key; };
ASSISTANT   in
ASSISTANT     {
ASSISTANT       inherit model-name;
ASSISTANT       litellm_params = {
ASSISTANT         inherit model;
ASSISTANT       } // provider-config;
ASSISTANT     }
ASSISTANT   ;
ASSISTANT 
ASSISTANT   lite-llm-config = {
ASSISTANT     model_list = lib.attrValues (lib.mapAttrs to-model-config lite-llm.models);
ASSISTANT   };
ASSISTANT 
ASSISTANT   lite-llm-config-yml =
ASSISTANT     pkgs.writeText "config.yml" (lib.generators.toYAML {} lite-llm-config)
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The package that provides the litellm proxy server.
ASSISTANT   */
ASSISTANT   litellm = pkgs.python3.withPackages (ps: [ ps.litellm ]);
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The list of providers that are used by the models of this
ASSISTANT   lite-llm instance. The list contains no duplicates.
ASSISTANT   */
ASSISTANT   used-providers = lib.unique (
ASSISTANT     lib.mapAttrsToList (_: { model, ... }:
ASSISTANT       lib.head (lib.strings.splitString "/" model)
ASSISTANT     ) lite-llm.models
ASSISTANT   );
ASSISTANT 
ASSISTANT   /**
ASSISTANT   Generates the shell commands that read the API key of the given
ASSISTANT   provider from the tool's configuration directory and export it
ASSISTANT   as an environmental variable. litellm will read the key from
ASSISTANT   the environmental variable when serving the provider's models.
ASSISTANT   */
ASSISTANT   to-api-key-setup = provider:
ASSISTANT   let
ASSISTANT     params = get-provider-params provider;
ASSISTANT     key-file = "$DEVTOOLS_CONFIG/${params.key-env-name}";
ASSISTANT   in
ASSISTANT   ''
ASSISTANT   if [[ ! -f "${key-file}" ]]; then
ASSISTANT     echo -e "\033[31mError: The API key for the '${provider}' provider is missing.\033[0m" >&2
ASSISTANT     echo "Save the key in '${key-file}' and launch '${lite-llm-name}' again." >&2
ASSISTANT     exit 1
ASSISTANT   fi
ASSISTANT   export ${params.key-env-name}="$(<"${key-file}")"
ASSISTANT   ''
ASSISTANT   ;
ASSISTANT 
ASSISTANT   api-key-setup = lib.concatStrings (map to-api-key-setup used-providers);
ASSISTANT 
ASSISTANT   /**
ASSISTANT   This wrapper script runs lite llm with the configuration
ASSISTANT   defined by the 'lite-llm-config-yml' derivation. The
ASSISTANT   process proceeds as follows:
ASSISTANT     1. Source the tool specific environment using the
ASSISTANT       'devtools-prelude.get-config' function. This will
ASSISTANT       define the DEVTOOLS_CONFIG environmental variable
ASSISTANT       which points to the tool's configuration directory
ASSISTANT       that will be used for storing things like provider
ASSISTANT       API keys.
ASSISTANT     2. Based on the llm models defined in the config,
ASSISTANT       define the necessary environmental variables for
ASSISTANT       the API keys. The variables will be read from files
ASSISTANT       located in the tool's configuration directory. The
ASSISTANT       expectation is that the user will put the api keys
ASSISTANT       in the right files. If the file does not exist,
ASSISTANT       exit and inform the user where to save the key.
ASSISTANT     3. Launch litellm with the settings specified by
ASSISTANT       the config comming from the 'lite-llm' value.
ASSISTANT       The strucutre of this object is speciifed
ASSISTANT       in the ./config.nix file.
ASSISTANT   */
ASSISTANT   launch-lite-llm = pkgs.writeScript "launch-${lite-llm-name}" ''
ASSISTANT     #!${pkgs.bash}/bin/bash
ASSISTANT     set -e
ASSISTANT 
ASSISTANT     source "${devtools-prelude.get-config lite-llm-name}"
ASSISTANT 
ASSISTANT     ${api-key-setup}
ASSISTANT 
ASSISTANT     exec ${litellm}/bin/litellm \
ASSISTANT       --config "${lite-llm-config-yml}" \
ASSISTANT       --port "${toString lite-llm.port}"
ASSISTANT   '';
ASSISTANT 
ASSISTANT in
ASSISTANT {
ASSISTANT   config.apps."devtools/${lite-llm-name}" = {
ASSISTANT     type = "app";
ASSISTANT     program = "${launch-lite-llm}";
ASSISTANT   };
ASSISTANT }
ASSISTANT ```
