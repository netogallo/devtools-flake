ASSISTANT llm-agent/setup.nix
ASSISTANT ```
ASSISTANT /**
ASSISTANT This module is responsible for generating all the flake attributes
ASSISTANT that result from an llm-agent configuration. Each configured agent
ASSISTANT is run inside a QEMU VM running NixOS; the agent connects to the
ASSISTANT llm provider specified in the configuration (e.g. a lite-llm
ASSISTANT instance running on the host machine).
ASSISTANT */
ASSISTANT {
ASSISTANT   config,
ASSISTANT   pkgs,
ASSISTANT   lib,
ASSISTANT   devtools-prelude,
ASSISTANT   llm-agent-name,
ASSISTANT   llm-agent,
ASSISTANT   nixpkgs,
ASSISTANT   ...
ASSISTANT }:
ASSISTANT let
ASSISTANT   /**
ASSISTANT   The python environment that runs the agent. The 'langchain'
ASSISTANT   package provides the agent machinery while 'langchain-openai'
ASSISTANT   provides the OpenAI-compatible client used to connect to the
ASSISTANT   llm provider (lite-llm exposes an OpenAI-compatible API).
ASSISTANT   */
ASSISTANT   agent-python = pkgs.python314.withPackages (ps: [
ASSISTANT     ps.langchain
ASSISTANT     ps.langchain-openai
ASSISTANT   ]);
ASSISTANT 
ASSISTANT   /**
ASSISTANT   Non-secret agent parameters, baked into the guest configuration.
ASSISTANT   The endpoint url comes from the provider configuration (for
ASSISTANT   lite-llm providers it points at the QEMU host alias so that
ASSISTANT   requests are forwarded to the instance running on the host).
ASSISTANT   */
ASSISTANT   provider-endpoint-url = llm-agent.provider.endpoint.url;
ASSISTANT   provider-model = llm-agent.provider.models.main.name;
ASSISTANT   provider-user = llm-agent.provider.user.name;
ASSISTANT   key-script =
ASSISTANT     with llm-agent.provider.user;
ASSISTANT     config.development-tools.llm-providers.${provider}.users.${name}.key-script
ASSISTANT   ; 
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The script implementing the deep agent. All secrets are read
ASSISTANT   at runtime from the environment / the shared key directory,
ASSISTANT   so nothing here is unsuitable for the nix store.
ASSISTANT   */
ASSISTANT   agent-script = pkgs.writeText "agent.py" ''
ASSISTANT     import os
ASSISTANT 
ASSISTANT     from langchain_openai import ChatOpenAI
ASSISTANT     from langchain_core.tools import tool
ASSISTANT     from langgraph.prebuilt import create_react_agent
ASSISTANT 
ASSISTANT     # --- Configuration (injected by the systemd service) ---
ASSISTANT     base_url = os.environ["OPENAI_BASE_URL"]
ASSISTANT     model = os.environ["OPENAI_MODEL"]
ASSISTANT     user = os.environ["AGENT_USER"]
ASSISTANT 
ASSISTANT     # --- API key: read at runtime from the shared config dir ---
ASSISTANT     key_file = os.path.join(os.environ["AGENT_KEYS_DIR"], "users", user + ".key")
ASSISTANT     with open(key_file) as f:
ASSISTANT         api_key = f.read().strip()
ASSISTANT 
ASSISTANT     # --- LLM client via the provider's OpenAI-compatible API ---
ASSISTANT     llm = ChatOpenAI(
ASSISTANT         model=model,
ASSISTANT         base_url=base_url,
ASSISTANT         api_key=api_key,
ASSISTANT     )
ASSISTANT 
ASSISTANT     # --- Dummy task tools ---
ASSISTANT     @tool
ASSISTANT     def list_files(directory: str) -> str:
ASSISTANT         """List the files in the given directory."""
ASSISTANT         return "\n".join(sorted(os.listdir(directory)))
ASSISTANT 
ASSISTANT     tools = [list_files]
ASSISTANT 
ASSISTANT     # --- The deep agent, given a dummy task ---
ASSISTANT     agent = create_react_agent(llm, tools)
ASSISTANT 
ASSISTANT     result = agent.invoke({
ASSISTANT         "messages": [
ASSISTANT             ("user",
ASSISTANT              "List the files in /tmp and briefly summarize what you find.")
ASSISTANT         ]
ASSISTANT     })
ASSISTANT 
ASSISTANT     for message in result["messages"]:
ASSISTANT         content = getattr(message, "content", None)
ASSISTANT         if content:
ASSISTANT             print(content)
ASSISTANT   '';
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The NixOS configuration of the guest VM. The agent runs as a
ASSISTANT   systemd service; the host's private configuration directory
ASSISTANT   (holding the provider authentication keys) is shared read-only
ASSISTANT   through a 9p mount so that secrets never enter the nix store
ASSISTANT   or the QEMU command line.
ASSISTANT   */
ASSISTANT   vm = nixpkgs.lib.nixosSystem {
ASSISTANT     modules = [
ASSISTANT       {
ASSISTANT         imports = [
ASSISTANT           "${nixpkgs}/nixos/modules/virtualisation/qemu-vm.nix"
ASSISTANT         ];
ASSISTANT         config = {
ASSISTANT           nixpkgs.hostPlatform = pkgs.system;
ASSISTANT           virtualisation.memorySize = 2048;
ASSISTANT           virtualisation.cores = 2;
ASSISTANT 
ASSISTANT           # Run the VM without a graphical display; the guest's
ASSISTANT           # serial port (ttyS0) is connected directly to the
ASSISTANT           # terminal that launched the VM, and the kernel console
ASSISTANT           # is placed on that serial line.
ASSISTANT           virtualisation.graphics = false;
ASSISTANT           boot.kernelParams = [ "console=ttyS0" ];
ASSISTANT 
ASSISTANT           # Share the host's private configuration directory with
ASSISTANT           # the guest through 9p. The mount is read-only; the agent
ASSISTANT           # only needs to read its authentication key.
ASSISTANT           virtualisation.qemu.options = [
ASSISTANT             ''-virtfs local,path="$DEVTOOLS_CONFIG",mount_tag=devtools-config,security_model=none,readonly=on''
ASSISTANT           ];
ASSISTANT           fileSystems."/run/agent-keys" = {
ASSISTANT             device = "devtools-config";
ASSISTANT             fsType = "9p";
ASSISTANT             options = [ "trans=virtio" "version=9p2000.L" "ro" ];
ASSISTANT           };
ASSISTANT           users.users.nixos.hashedPassword = "$y$j9T$Ij.zgsiQ9UbG805vuIjz0/$qiZCBxun/3VJrAic6AGusQTlX4VN2W.Mp4LrFPrFZ6B";
ASSISTANT           users.users.nixos.group = "nixos";
ASSISTANT           users.groups.nixos = {};
ASSISTANT           users.users.nixos.isNormalUser = true;
ASSISTANT 
ASSISTANT           # The agent service. Non-secret parameters are baked in;
ASSISTANT           # the api key is read from the shared directory at runtime.
ASSISTANT           # The service's output is forwarded to the kernel log so
ASSISTANT           # that it shows up on the serial console, i.e. in the
ASSISTANT           # terminal that launched the VM.
ASSISTANT           systemd.services.llm-agent = {
ASSISTANT             description = "LangChain deep agent";
ASSISTANT             wantedBy = [ "multi-user.target" ];
ASSISTANT             after = [ "network-online.target" ];
ASSISTANT             wants = [ "network-online.target" ];
ASSISTANT             environment = {
ASSISTANT               OPENAI_BASE_URL = provider-endpoint-url;
ASSISTANT               OPENAI_MODEL = provider-model;
ASSISTANT               AGENT_USER = provider-user;
ASSISTANT               AGENT_KEYS_DIR = "/run/agent-keys";
ASSISTANT             };
ASSISTANT             serviceConfig = {
ASSISTANT               Type = "oneshot";
ASSISTANT               RemainAfterExit = true;
ASSISTANT               StandardOutput = "kmsg";
ASSISTANT               StandardError = "kmsg";
ASSISTANT             };
ASSISTANT             script = ''
ASSISTANT               exec ${agent-python}/bin/python ${agent-script}
ASSISTANT             '';
ASSISTANT           };
ASSISTANT         };
ASSISTANT       }
ASSISTANT     ];
ASSISTANT   };
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The host-side launch script. It sources the tool specific
ASSISTANT   environment (defining DEVTOOLS_CONFIG), warns if no llm
ASSISTANT   provider is reachable on the host, and boots the VM with
ASSISTANT   the private configuration directory shared through 9p.
ASSISTANT   */
ASSISTANT   launch-llm-agent = pkgs.writeScript "launch-${llm-agent-name}" ''
ASSISTANT     #!${pkgs.bash}/bin/bash
ASSISTANT     set -e
ASSISTANT 
ASSISTANT     source "${devtools-prelude.get-config llm-agent-name}"
ASSISTANT 
ASSISTANT     if ! ${pkgs.curl}/bin/curl -s "${provider-endpoint-url}" >/dev/null 2>&1; then
ASSISTANT       echo -e "\033[33mWarning: no llm provider seems to be reachable at '${provider-endpoint-url}'.\033[0m" >&2
ASSISTANT       echo "If a lite-llm instance provides this model, launch it on the host first." >&2
ASSISTANT     fi
ASSISTANT 
ASSISTANT     user_key=$(${key-script})
ASSISTANT     user_key_dir="$DEVTOOLS_CONFIG/users/"
ASSISTANT     mkdir -p "$user_key_dir"
ASSISTANT     echo "$user_key" > "$user_key_dir/${provider-user}.key"
ASSISTANT     export DEVTOOLS_CONFIG
ASSISTANT     exec ${vm.config.system.build.vm}/bin/run-nixos-vm
ASSISTANT   '';
ASSISTANT 
ASSISTANT in
ASSISTANT {
ASSISTANT   config.apps."devtools/${llm-agent-name}" = {
ASSISTANT     type = "app";
ASSISTANT     program = "${launch-llm-agent}";
ASSISTANT   };
ASSISTANT }
ASSISTANT ```
ASSISTANT 
ASSISTANT Summary of the changes:
ASSISTANT 
ASSISTANT 1. Added `virtualisation.graphics = false;` — QEMU runs with `-nographic`, connecting the guest's `ttyS0` to the launching terminal.
ASSISTANT 2. Added `boot.kernelParams = [ "console=ttyS0" ];` — the kernel console (and thus `kmsg` output) goes to the serial line.
ASSISTANT 3. Added `StandardOutput = "kmsg";` and `StandardError = "kmsg";` to the agent service — the agent's stdout/stderr are forwarded to the kernel log, which appears on the serial console, i.e. in the terminal that launched the VM.
