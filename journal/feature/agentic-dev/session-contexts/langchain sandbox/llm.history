ASSISTANT     options = {
ASSISTANT       model = mkOption {
ASSISTANT         type = types.str;
ASSISTANT         description = ''
ASSISTANT           The name of the model. This formatter as '<provider>/<model vendor>/model'. As
ASSISTANT           an example 'openrouter/openai/gpt-4'.
ASSISTANT         '';
ASSISTANT       };
ASSISTANT     };
ASSISTANT   };
ASSISTANT 
ASSISTANT   # This submodule configures a user that is allowed
ASSISTANT   # to authenticate against the llm-lite instance. No
ASSISTANT   # options are defined yet; the submodule exists so that
ASSISTANT   # per-user settings (e.g. rate limits) can be added
ASSISTANT   # later without changing the shape of the configuration.
ASSISTANT   # The authentication key is deliberately not an option:
ASSISTANT   # keys are generated when the instance is launched and
ASSISTANT   # never enter the nix store.
ASSISTANT   user-spec = types.submodule {
ASSISTANT     options = {};
ASSISTANT   };
ASSISTANT   spec = types.submodule {
ASSISTANT     options = {
ASSISTANT       enable = mkOption {
ASSISTANT         type = types.bool;
ASSISTANT         description = ''
ASSISTANT           Enable the configuration. This adds an item to the
ASSISTANT           set of devtools available to the flake.
ASSISTANT         '';
ASSISTANT       };
ASSISTANT 
ASSISTANT       models = mkOption {
ASSISTANT         type = types.attrsOf model-spec;
ASSISTANT         description = ''
ASSISTANT           Holds the configuration of all the models that will be available
ASSISTANT           to the llmlite instance.
ASSISTANT         '';
ASSISTANT       };
ASSISTANT 
ASSISTANT       users = mkOption {
ASSISTANT         type = types.attrsOf user-spec;
ASSISTANT         default = {};
ASSISTANT         description = ''
ASSISTANT           The users that are allowed to authenticate against this
ASSISTANT           llm-lite instance, keyed by user name. Authentication keys
ASSISTANT           are generated when the instance is launched and are stored
ASSISTANT           in the tool's private configuration directory; they are not
ASSISTANT           part of this configuration. User names are used as file names
ASSISTANT           for the keys, so they must be file-name-safe. Authentication
ASSISTANT           is enabled only when at least one user is defined.
ASSISTANT         '';
ASSISTANT       };
ASSISTANT 
ASSISTANT       port = mkOption {
ASSISTANT         type = types.int;
ASSISTANT         description = ''
ASSISTANT           The port on which lite-llm will be served.
ASSISTANT         '';
ASSISTANT         default = 4000;
ASSISTANT       };
ASSISTANT     };
ASSISTANT   };
ASSISTANT   perSystem = _:
