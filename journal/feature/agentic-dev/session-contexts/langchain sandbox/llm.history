ASSISTANT top@{ self, lib, config, flake-parts-lib, ... }:
ASSISTANT let
ASSISTANT   inherit (lib) types mkOption;
ASSISTANT   inherit (flake-parts-lib) mkPerSystemOption;
ASSISTANT 
ASSISTANT   # This submodule will be used
ASSISTANT   # to configure the settings of the
ASSISTANT   # modules that the llm-lite configuration
ASSISTANT   # will be serving.
