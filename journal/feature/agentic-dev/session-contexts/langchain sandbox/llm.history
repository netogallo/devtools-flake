USER     # --- Dummy task tools ---
USER     @tool
USER     def list_files(directory: str) -> str:
USER         """List the files in the given directory."""
USER         return "\n".join(sorted(os.listdir(directory)))
USER 
USER     tools = [list_files]
USER 
USER     # --- The deep agent, given a dummy task ---
USER     agent = create_react_agent(llm, tools)
USER 
USER     result = agent.invoke({
USER         "messages": [
USER             ("user",
USER              "List the files in /tmp and briefly summarize what you find.")
USER         ]
USER     })
USER 
USER     for message in result["messages"]:
USER         content = getattr(message, "content", None)
USER         if content:
USER             print(content)
USER   '';
USER 
USER   /**
USER   The NixOS configuration of the guest VM. The agent runs as a
USER   systemd service; the host's private configuration directory
USER   (holding the provider authentication keys) is shared read-only
USER   through a 9p mount so that secrets never enter the nix store
USER   or the QEMU command line.
USER   */
USER   vm = nixpkgs.lib.nixosSystem {
USER     modules = [
USER       {
USER         imports = [
USER           "${nixpkgs}/nixos/modules/virtualisation/qemu-vm.nix"
USER         ];
USER         config = {
USER           nixpkgs.hostPlatform = pkgs.system;
USER           virtualisation.memorySize = 2048;
USER           virtualisation.cores = 2;
USER 
USER           # Share the host's private configuration directory with
USER           # the guest through 9p. The mount is read-only; the agent
USER           # only needs to read its authentication key.
USER           virtualisation.qemu.options = [
USER             ''-virtfs local,path="$DEVTOOLS_CONFIG",mount_tag=devtools-config,security_model=none,readonly=on''
USER           ];
USER           fileSystems."/run/agent-keys" = {
USER             device = "devtools-config";
USER             fsType = "9p";
USER             options = [ "trans=virtio" "version=9p2000.L" "ro" ];
USER           };
USER           users.users.nixos.hashedPassword = "$y$j9T$Ij.zgsiQ9UbG805vuIjz0/$qiZCBxun/3VJrAic6AGusQTlX4VN2W.Mp4LrFPrFZ6B";
USER           users.users.nixos.group = "nixos";
USER           users.groups.nixos = {};
USER           users.users.nixos.isNormalUser = true;
USER 
USER           # The agent service. Non-secret parameters are baked in;
USER           # the api key is read from the shared directory at runtime.
USER           systemd.services.llm-agent = {
USER             description = "LangChain deep agent";
USER             wantedBy = [ "multi-user.target" ];
USER             after = [ "network-online.target" ];
USER             wants = [ "network-online.target" ];
USER             environment = {
USER               OPENAI_BASE_URL = provider-endpoint-url;
USER               OPENAI_MODEL = provider-model;
USER               AGENT_USER = provider-user;
USER               AGENT_KEYS_DIR = "/run/agent-keys";
USER             };
USER             serviceConfig = {
USER               Type = "oneshot";
USER               RemainAfterExit = true;
USER             };
