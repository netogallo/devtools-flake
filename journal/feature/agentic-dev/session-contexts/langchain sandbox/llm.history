USER lite-llm/setup.nix
USER ```
USER /**
USER This module is responsible for generating all the flake attributes
USER that result from a lite-llm configuration. Multiple named lite-llm
USER configurations can be present in a flake, each will result in
USER a separate set of attributes in the flake.
USER */
USER { pkgs, lib, devtools-prelude, lite-llm-name, lite-llm, ... }:
USER let
USER   /**
USER   Contains llm provider specific parameters
USER   that are used to build the lite-llm configuration.
USER   This includes:
USER     - api_key: The provider API key. For security reasons, the
USER       key is not saved to the nix store. Instead each provider
USER       will read it from a specific environmental variable.
USER       When the lite-llm instance is launched, these variables
USER       will be set by reading the keys from a private directory.
USER   */
USER   provider-params = {
USER     openrouter = rec {
USER       key-env-name = "OPENROUTER_API_KEY";
USER       api_key = "os.environ/${key-env-name}";
USER     };
USER   };
USER 
USER   get-provider-params = model:
USER   let
USER     parts = lib.strings.splitString "/" model;
USER     provider = lib.elemAt parts 0;
USER   in
USER     if lib.hasAttr provider provider-params
USER     then provider-params.${provider}
USER     else throw "Unsupported model provider '${provider}'"
USER   ;
USER 
USER   /**
USER   Create an attribute set matching the configuration that
USER   lite-llm expects for each model definition.
USER   */
USER   to-model-config = model_name: { model, ... }:
USER   let
USER     provider-params = get-provider-params model;
USER     provider-config = { inherit (provider-params) api_key; };
USER   in
USER     {
USER       inherit model_name;
USER       litellm_params = {
USER         inherit model;
USER       } // provider-config;
USER     }
USER   ;
USER 
USER   /**
USER   The names of the users defined in the configuration. The names
USER   are used as file names for the generated authentication keys,
USER   so they are validated to only contain file-name-safe characters.
USER   */
USER   user-names =
USER   let
USER     names = lib.attrNames lite-llm.users;
USER     invalid = lib.filter (name: builtins.match "[A-Za-z0-9_][A-Za-z0-9_.-]*" name == null) names;
USER   in
USER     if invalid == [ ]
USER     then names
USER     else throw "lite-llm user names must be file-name-safe, invalid: ${toString invalid}"
USER   ;
USER 
USER   /**
USER   A litellm custom authenticator that validates the bearer token
USER   of each request against the keys of the users defined in the
USER   configuration. litellm 1.89.0 no longer ships the class based
USER   'CustomAuth' interface; the supported interface is the module
USER   level 'user_api_key_auth' coroutine. litellm calls it with the
USER   incoming request and the presented api key: raising an exception
USER   rejects the request, returning a key allows it. The keys are
USER   stored in the tool's configuration directory, one file per user,
USER   under the directory pointed to by the 'LITE_LLM_USERS_DIR'
USER   environmental variable, which is exported by the launch script
USER   before litellm starts. Only the user names are embedded in the
USER   module, so removing a user from the configuration revokes their
USER   access even if their key file still exists.
USER   */
USER   custom-auth = pkgs.writeText "custom_auth.py" ''
USER     import os
USER     from typing import Union
USER 
USER     from fastapi import Request
USER 
USER     from litellm.proxy._types import ProxyException, UserAPIKeyAuth
USER 
USER     USERS = ${builtins.toJSON user-names}
USER 
USER     def invalid_api_key() -> ProxyException:
USER         return ProxyException(
USER             message="Invalid API key",
USER             type="invalid_request_error",
USER             param="api_key",
USER             code=401,
USER         )
USER 
USER     async def user_api_key_auth(
USER         request: Request, api_key: str
USER     ) -> Union[UserAPIKeyAuth, str]:
USER         users_dir = os.environ.get("LITE_LLM_USERS_DIR", "")
USER         if not api_key or not users_dir:
USER             raise invalid_api_key()
USER         for user in USERS:
USER             try:
USER                 with open(os.path.join(users_dir, user + ".key")) as key_file:
USER                     if key_file.read().strip() == api_key:
USER                         return UserAPIKeyAuth(api_key=api_key)
USER             except OSError:
USER                 continue
USER         raise invalid_api_key()
USER   '';
USER 
USER   master-key-name = "LITELLM_MASTER_KEY";
USER 
USER   lite-llm-config = {
USER     model_list = lib.attrValues (lib.mapAttrs to-model-config lite-llm.models);
USER     master_key = "os.environ/${master-key-name}";
USER   } // lib.optionalAttrs (user-names != [ ]) {
USER     general_settings.custom_auth = "custom_auth.user_api_key_auth";
USER   };
USER 
USER   lite-llm-config-yml =
USER     pkgs.writeText "config.yml" (lib.generators.toYAML {} lite-llm-config)
USER   ;
USER 
USER   /**
USER   A directory that bundles the lite-llm yaml configuration together
USER   with the custom authenticator module. litellm resolves the custom
USER   authenticator relative to the directory that contains the yaml
USER   configuration, so both files need to reside in the same directory.
USER   */
USER   lite-llm-config-dir = pkgs.runCommand "litellm-config-${lite-llm-name}" {} ''
USER     mkdir -p "$out"
USER     cp "${lite-llm-config-yml}" "$out/config.yml"
USER     cp "${custom-auth}" "$out/custom_auth.py"
USER   '';
USER 
USER   /**
USER   The environment that provides the 'litellm' executable, the
USER   proxy server that serves the configured models. The nixpkgs
USER   'litellm' package only propagates the dependencies of the
USER   core library, but running the proxy server requires the
USER   dependencies of the 'proxy' extra, i.e. the ones that
USER   'pip install litellm[proxy]' would install. Those are added
USER   to the environment explicitly.
USER   */
USER   litellm = pkgs.python3.withPackages (ps:
USER     [ ps.litellm ]
USER     ++ ps.litellm.optional-dependencies.proxy
USER   );
USER 
USER   /**
USER   The list of model providers used by the models configured for
USER   this lite-llm instance. The list contains no duplicates.
USER   */
USER   used-providers = lib.unique (
USER     lib.mapAttrsToList (_: { model, ... }:
USER       lib.head (lib.strings.splitString "/" model)
USER     ) lite-llm.models
USER   );
USER 
USER   /**
USER   Generate the shell commands that read the API key of the given
USER   provider from a file located in the tool's configuration
USER   directory (DEVTOOLS_CONFIG) and export it as an environmental
USER   variable. The key is expected to be saved in a file named after
USER   the environmental variable that lite-llm reads it from. If the
USER   file does not exist, the commands inform the user where to save
USER   the key and exit with a non-zero status.
USER   */
USER   to-api-key-setup = provider:
USER   let
USER     params = get-provider-params provider;
USER     key-file = "$DEVTOOLS_CONFIG/${params.key-env-name}";
USER   in
USER   ''
USER   if [[ ! -f "${key-file}" ]]; then
USER     echo -e "\033[31mError: The API key for the '${provider}' provider is missing.\033[0m" >&2
USER     echo "Save the key in '${key-file}' and launch '${lite-llm-name}' again." >&2
USER     exit 1
USER   fi
USER   export ${params.key-env-name}="$(<"${key-file}")"
USER   ''
USER   ;
USER 
USER   api-key-setup = lib.concatStrings (map to-api-key-setup used-providers);
USER 
USER   /**
USER   Generate the shell commands that ensure that the given user has
USER   an authentication key. The key is stored in a file named after
USER   the user, located in the users directory of the tool's
USER   configuration directory. If the file does not exist, a random
USER   key is generated and saved there. Existing keys are never
USER   overwritten, so keys are re-used across launches.
USER   */
USER   to-user-key-setup = user:
USER   ''
USER   if [[ ! -f "$users_dir/${user}.key" ]]; then
USER     ${pkgs.openssl}/bin/openssl rand -hex 32 > "$users_dir/${user}.key"
USER     chmod 600 "$users_dir/${user}.key"
USER     echo "Generated the authentication key of '${user}': $users_dir/${user}.key"
USER   fi
USER   ''
USER   ;
USER 
USER   /**
USER   Set the lite-llm master key. This key will be generated if
USER   missing. Afterwards it will be loaded into the environment.
USER   */
USER   master-key-setup =
USER   ''
USER   master_key="$DEVTOOLS_CONFIG/${master-key-name}.key"
USER 
USER   if [[ ! -f "$master_key" ]]; then
USER     ${pkgs.openssl}/bin/openssl rand -hex 32 > "$master_key"
USER     chmod 600 "$users_dir/$master_key"
USER     echo "Generated the master authentication key at $master_key"
USER   fi
USER 
USER   export ${master-key-name}="$(<$master_key)"
USER   ''
USER   ;
USER 
USER   /**
USER   The shell commands that prepare the authentication keys of all
USER   the users defined in the configuration. The directory holding
USER   the keys is exported through the 'LITE_LLM_USERS_DIR'
USER   environmental variable so that the custom authenticator can
USER   locate it. When no users are defined the commands are empty and
USER   no authentication is enabled.
USER   */
USER   users-setup =
USER     if user-names == [ ]
USER     then ""
USER     else
USER     ''
USER     users_dir="$DEVTOOLS_CONFIG/users"
USER     mkdir -p "$users_dir"
USER     export LITE_LLM_USERS_DIR="$users_dir"
USER     ${lib.concatStrings (map to-user-key-setup user-names)}
USER     ''
USER   ;
USER 
USER   /**
USER   This wrapper script runs lite-llm with the configuration
USER   defined by the 'lite-llm-config-dir' derivation. The
USER   process proceeds as follows:
USER     1. Source the tool specific environment using the
USER       'devtools-prelude.get-config' function. This will
USER       define the DEVTOOLS_CONFIG environmental variable
USER       which points to the tool's configuration directory
USER       that will be used for storing things like provider
USER       API keys.
USER     2. Based on the llm models defined in the config,
USER       define the necessary environmental variables for
USER       the API keys. The variables will be read from files
USER       located in the tool's configuration directory. The
USER       expectation is that the user will put the api keys
USER       in the right files. If the file does not exist,
USER       exit and inform the user where to save the key.
USER     3. Based on the users defined in the config, ensure
USER       that each user has an authentication key. A random
USER       key is generated for users that do not have one
USER       yet; existing keys are re-used. The directory
USER       holding the keys is exported through the
USER       'LITE_LLM_USERS_DIR' environmental variable, which
USER       is read by the custom authenticator.
USER     4. Launch litellm with the settings specified by
USER       the config coming from the 'lite-llm' value.
USER       The structure of this object is specified
USER       in the ./config.nix file.
USER   */
USER   launch-lite-llm = pkgs.writeScript "launch-${lite-llm-name}" ''
USER     #!${pkgs.bash}/bin/bash
USER     set -e
USER 
USER     source "${devtools-prelude.get-config lite-llm-name}"
USER 
USER     ${master-key-setup}
USER 
USER     ${api-key-setup}
USER 
USER     ${users-setup}
USER 
USER     exec ${litellm}/bin/litellm \
USER       --config "${lite-llm-config-dir}/config.yml" \
USER       --port "${toString lite-llm.port}"
USER   '';
USER 
USER in
USER {
USER   config.apps."devtools/${lite-llm-name}" = {
USER     type = "app";
USER     program = "${launch-lite-llm}";
USER   };
USER }
