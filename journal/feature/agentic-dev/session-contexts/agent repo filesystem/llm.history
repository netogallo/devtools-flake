USER /**
USER This module is responsible for generating all the flake attributes
USER that result from an llm-agent configuration. Each configured agent
USER is run inside a QEMU VM running NixOS; the agent connects to the
USER llm provider specified in the configuration (e.g. a lite-llm
USER instance running on the host machine).
USER */
USER {
USER   config,
USER   pkgs,
USER   lib,
USER   devtools-prelude,
USER   llm-agent-name,
USER   llm-agent,
USER   nixpkgs,
USER   ...
USER }:
USER let
USER   /**
USER   The python environment that runs the agent. The 'langchain'
USER   package provides the agent machinery while 'langchain-openai'
USER   provides the OpenAI-compatible client used to connect to the
USER   llm provider (lite-llm exposes an OpenAI-compatible API).
USER   */
USER   agent-python = pkgs.python314.withPackages (ps: [
USER     ps.langchain
USER     ps.langchain-openai
USER   ]);
USER 
USER   /**
USER   Non-secret agent parameters, baked into the guest configuration.
USER   The endpoint url comes from the provider configuration (for
USER   lite-llm providers it points at the QEMU host alias so that
USER   requests are forwarded to the instance running on the host).
USER   */
USER   provider-endpoint-url = llm-agent.provider.endpoint.url;
USER   provider-model = llm-agent.provider.models.main.name;
USER   provider-user = llm-agent.provider.user.name;
USER   key-script =
USER     with llm-agent.provider.user;
USER     config.development-tools.llm-providers.${provider}.users.${name}.key-script
USER   ;
USER 
USER   /**
USER   The script implementing the deep agent. All secrets are read
USER   at runtime from the environment / the shared key directory,
USER   so nothing here is unsuitable for the nix store.
USER   */
USER   agent-script = pkgs.writeText "agent.py" ''
USER     import os
USER 
USER     from langchain_openai import ChatOpenAI
USER     from langchain_core.tools import tool
USER     from langgraph.prebuilt import create_react_agent
USER 
USER     # --- Configuration (injected by the systemd service) ---
USER     base_url = os.environ["OPENAI_BASE_URL"]
USER     model = os.environ["OPENAI_MODEL"]
USER     user = os.environ["AGENT_USER"]
USER 
USER     # --- API key: read at runtime from the shared config dir ---
USER     key_file = os.path.join(os.environ["AGENT_KEYS_DIR"], "users", user + ".key")
USER     with open(key_file) as f:
USER         api_key = f.read().strip()
USER 
USER     # --- LLM client via the provider's OpenAI-compatible API ---
USER     llm = ChatOpenAI(
USER         model=model,
USER         base_url=base_url,
USER         api_key=api_key,
USER     )
USER 
USER     # --- Dummy task tools ---
USER     @tool
USER     def list_files(directory: str) -> str:
USER         """List the files in the given directory."""
USER         return "\n".join(sorted(os.listdir(directory)))
USER 
USER     tools = [list_files]
USER 
USER     # --- The deep agent, given a dummy task ---
USER     agent = create_react_agent(llm, tools)
USER 
USER     result = agent.invoke({
USER         "messages": [
USER             ("user",
USER              "List the files in /tmp and briefly summarize what you find.")
USER         ]
USER     })
USER 
USER     for message in result["messages"]:
USER         content = getattr(message, "content", None)
USER         if content:
USER             print(content)
USER   '';
USER 
USER   /**
USER   The NixOS configuration of the guest VM. The agent runs as a
USER   systemd service; the host's private configuration directory
USER   (holding the provider authentication keys) is shared read-only
USER   through a 9p mount so that secrets never enter the nix store
USER   or the QEMU command line.
USER   */
USER   vm = nixpkgs.lib.nixosSystem {
USER     modules = [
USER       {
USER         imports = [
USER           "${nixpkgs}/nixos/modules/virtualisation/qemu-vm.nix"
USER         ];
USER         config = {
USER           nixpkgs.hostPlatform = pkgs.system;
USER           virtualisation.memorySize = 2048;
USER           virtualisation.cores = 2;
USER 
USER           # Run the VM without a graphical display; the guest's
USER           # serial port (ttyS0) is connected directly to the
USER           # terminal that launched the VM, and the kernel console
USER           # is placed on that serial line.
USER           virtualisation.graphics = false;
USER           boot.kernelParams = [ "console=ttyS0" ];
USER 
USER           # Share the host's private configuration directory with
