ASSISTANT Full setup.nix:
ASSISTANT 
ASSISTANT ```nix
ASSISTANT /**
ASSISTANT This module is responsible for generating all the flake attributes
ASSISTANT that result from a lite-llm configuration. Multiple named lite-llm
ASSISTANT configurations can be present in a flake, each will result in
ASSISTANT a separate set of attributes in the flake.
ASSISTANT */
ASSISTANT { pkgs, lib, devtools-prelude, lite-llm-name, lite-llm, ... }:
ASSISTANT let
ASSISTANT   /**
ASSISTANT   Contains llm provider specific parameters
ASSISTANT   that are used to build the lite-llm configuration.
ASSISTANT   This includes:
ASSISTANT     - api_key: The provider API key. For security reasons, the
ASSISTANT       key is not saved to the nix store. Instead each provider
ASSISTANT       will read it from a specific environmental variable.
ASSISTANT       When the lite-llm instance is launched, these variables
ASSISTANT       will be set by reading the keys from a private directory.
ASSISTANT   */
ASSISTANT   provider-params = {
ASSISTANT     openrouter = rec {
ASSISTANT       key-env-name = "OPENROUTER_API_KEY";
ASSISTANT       api_key = "os.environ/${key-env-name}";
ASSISTANT     };
ASSISTANT   };
ASSISTANT 
ASSISTANT   get-provider-params = model:
ASSISTANT   let
ASSISTANT     parts = lib.strings.splitString "/" model;
ASSISTANT     provider = lib.elemAt parts 0;
ASSISTANT   in
ASSISTANT     if lib.hasAttr provider provider-params
ASSISTANT     then provider-params.${provider}
ASSISTANT     else throw "Unsupported model provider '${provider}'"
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT   Create an attribute set matching the configuration that
ASSISTANT   lite-llm expects for each model definition.
ASSISTANT   */
ASSISTANT   to-model-config = model_name: { model, ... }:
ASSISTANT   let
ASSISTANT     provider-params = get-provider-params model;
ASSISTANT     provider-config = { inherit (provider-params) api_key; };
ASSISTANT   in
ASSISTANT     {
ASSISTANT       inherit model_name;
ASSISTANT       litellm_params = {
ASSISTANT         inherit model;
ASSISTANT       } // provider-config;
ASSISTANT     }
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The names of the users defined in the configuration. The names
ASSISTANT   are used as file names for the generated authentication keys,
ASSISTANT   so they are validated to only contain file-name-safe characters.
ASSISTANT   */
ASSISTANT   user-names =
ASSISTANT   let
ASSISTANT     names = lib.attrNames lite-llm.users;
ASSISTANT     invalid = lib.filter (name: builtins.match "[A-Za-z0-9_][A-Za-z0-9_.-]*" name == null) names;
ASSISTANT   in
ASSISTANT     if invalid == [ ]
ASSISTANT     then names
ASSISTANT     else throw "lite-llm user names must be file-name-safe, invalid: ${toString invalid}"
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT   A litellm custom authenticator that validates the bearer token
ASSISTANT   of each request against the keys of the users defined in the
ASSISTANT   configuration. The keys are stored in the tool's configuration
ASSISTANT   directory, one file per user, under the directory pointed to by
ASSISTANT   the 'LITE_LLM_USERS_DIR' environmental variable, which is
ASSISTANT   exported by the launch script before litellm starts. Only the
ASSISTANT   user names are embedded in the module. This ensures that
ASSISTANT   removing a user from the configuration revokes their access
ASSISTANT   even if their key file still exists.
ASSISTANT   */
ASSISTANT   custom-auth = pkgs.writeText "custom_auth.py" ''
ASSISTANT     import os
ASSISTANT 
ASSISTANT     from litellm.integrations.custom_auth import CustomAuth
ASSISTANT 
ASSISTANT     USERS = ${builtins.toJSON user-names}
ASSISTANT 
ASSISTANT     class UserKeyAuth(CustomAuth):
ASSISTANT         def auth(self, token: str) -> bool:
ASSISTANT             users_dir = os.environ.get("LITE_LLM_USERS_DIR", "")
ASSISTANT             if not token or not users_dir:
ASSISTANT                 return False
ASSISTANT             for user in USERS:
ASSISTANT                 try:
ASSISTANT                     with open(os.path.join(users_dir, user + ".key")) as key_file:
ASSISTANT                         if key_file.read().strip() == token:
ASSISTANT                             return True
ASSISTANT                 except OSError:
ASSISTANT                     continue
ASSISTANT             return False
ASSISTANT   '';
ASSISTANT 
ASSISTANT   lite-llm-config = {
ASSISTANT     model_list = lib.attrValues (lib.mapAttrs to-model-config lite-llm.models);
ASSISTANT   } // lib.optionalAttrs (user-names != [ ]) {
ASSISTANT     general_settings.custom_auth = "custom_auth.UserKeyAuth";
ASSISTANT   };
ASSISTANT 
ASSISTANT   lite-llm-config-yml =
ASSISTANT     pkgs.writeText "config.yml" (lib.generators.toYAML {} lite-llm-config)
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT   A directory that bundles the lite-llm yaml configuration together
ASSISTANT   with the custom authenticator module. litellm resolves the custom
ASSISTANT   authenticator relative to the directory that contains the yaml
ASSISTANT   configuration, so both files need to reside in the same directory.
ASSISTANT   */
ASSISTANT   lite-llm-config-dir = pkgs.runCommand "litellm-config-${lite-llm-name}" {} ''
ASSISTANT     mkdir -p "$out"
ASSISTANT     cp "${lite-llm-config-yml}" "$out/config.yml"
ASSISTANT     cp "${custom-auth}" "$out/custom_auth.py"
ASSISTANT   '';
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The environment that provides the 'litellm' executable, the
ASSISTANT   proxy server that serves the configured models. The nixpkgs
ASSISTANT   'litellm' package only propagates the dependencies of the
ASSISTANT   core library, but running the proxy server requires the
ASSISTANT   dependencies of the 'proxy' extra, i.e. the ones that
ASSISTANT   'pip install litellm[proxy]' would install. Those are added
ASSISTANT   to the environment explicitly.
ASSISTANT   */
ASSISTANT   litellm = pkgs.python3.withPackages (ps:
ASSISTANT     [ ps.litellm ]
ASSISTANT     ++ ps.litellm.optional-dependencies.proxy
ASSISTANT   );
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The list of model providers used by the models configured for
ASSISTANT   this lite-llm instance. The list contains no duplicates.
ASSISTANT   */
ASSISTANT   used-providers = lib.unique (
ASSISTANT     lib.mapAttrsToList (_: { model, ... }:
ASSISTANT       lib.head (lib.strings.splitString "/" model)
ASSISTANT     ) lite-llm.models
ASSISTANT   );
ASSISTANT 
ASSISTANT   /**
ASSISTANT   Generate the shell commands that read the API key of the given
ASSISTANT   provider from a file located in the tool's configuration
ASSISTANT   directory (DEVTOOLS_CONFIG) and export it as an environmental
ASSISTANT   variable. The key is expected to be saved in a file named after
ASSISTANT   the environmental variable that lite-llm reads it from. If the
ASSISTANT   file does not exist, the commands inform the user where to save
ASSISTANT   the key and exit with a non-zero status.
ASSISTANT   */
ASSISTANT   to-api-key-setup = provider:
ASSISTANT   let
ASSISTANT     params = get-provider-params provider;
ASSISTANT     key-file = "$DEVTOOLS_CONFIG/${params.key-env-name}";
ASSISTANT   in
ASSISTANT   ''
ASSISTANT   if [[ ! -f "${key-file}" ]]; then
ASSISTANT     echo -e "\033[31mError: The API key for the '${provider}' provider is missing.\033[0m" >&2
ASSISTANT     echo "Save the key in '${key-file}' and launch '${lite-llm-name}' again." >&2
ASSISTANT     exit 1
ASSISTANT   fi
ASSISTANT   export ${params.key-env-name}="$(<"${key-file}")"
ASSISTANT   ''
ASSISTANT   ;
ASSISTANT 
ASSISTANT   api-key-setup = lib.concatStrings (map to-api-key-setup used-providers);
ASSISTANT 
ASSISTANT   /**
ASSISTANT   Generate the shell commands that ensure that the given user has
ASSISTANT   an authentication key. The key is stored in a file named after
ASSISTANT   the user, located in the users directory of the tool's
ASSISTANT   configuration directory. If the file does not exist, a random
ASSISTANT   key is generated and saved there. Existing keys are never
ASSISTANT   overwritten, so keys are re-used across launches.
ASSISTANT   */
ASSISTANT   to-user-key-setup = user:
ASSISTANT   ''
ASSISTANT   if [[ ! -f "$users_dir/${user}.key" ]]; then
ASSISTANT     ${pkgs.openssl}/bin/openssl rand -hex 32 > "$users_dir/${user}.key"
ASSISTANT     chmod 600 "$users_dir/${user}.key"
ASSISTANT     echo "Generated the authentication key of '${user}': $users_dir/${user}.key"
ASSISTANT   fi
ASSISTANT   ''
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT   The shell commands that prepare the authentication keys of all
ASSISTANT   the users defined in the configuration. The directory holding
ASSISTANT   the keys is exported through the 'LITE_LLM_USERS_DIR'
ASSISTANT   environmental variable so that the custom authenticator can
ASSISTANT   locate it. When no users are defined the commands are empty and
ASSISTANT   no authentication is enabled.
ASSISTANT   */
ASSISTANT   users-setup =
ASSISTANT     if user-names == [ ]
ASSISTANT     then ""
ASSISTANT     else
ASSISTANT     ''
ASSISTANT     users_dir="$DEVTOOLS_CONFIG/users"
ASSISTANT     mkdir -p "$users_dir"
ASSISTANT     export LITE_LLM_USERS_DIR="$users_dir"
ASSISTANT     ${lib.concatStrings (map to-user-key-setup user-names)}
ASSISTANT     ''
ASSISTANT   ;
ASSISTANT 
ASSISTANT   /**
ASSISTANT   This wrapper script runs lite-llm with the configuration
ASSISTANT   defined by the 'lite-llm-config-dir' derivation. The
ASSISTANT   process proceeds as follows:
ASSISTANT     1. Source the tool specific environment using the
ASSISTANT       'devtools-prelude.get-config' function. This will
ASSISTANT       define the DEVTOOLS_CONFIG environmental variable
ASSISTANT       which points to the tool's configuration directory
ASSISTANT       that will be used for storing things like provider
ASSISTANT       API keys.
ASSISTANT     2. Based on the llm models defined in the config,
ASSISTANT       define the necessary environmental variables for
ASSISTANT       the API keys. The variables will be read from files
ASSISTANT       located in the tool's configuration directory. The
ASSISTANT       expectation is that the user will put the api keys
ASSISTANT       in the right files. If the file does not exist,
ASSISTANT       exit and inform the user where to save the key.
ASSISTANT     3. Based on the users defined in the config, ensure
ASSISTANT       that each user has an authentication key. A random
ASSISTANT       key is generated for users that do not have one
ASSISTANT       yet; existing keys are re-used. The directory
ASSISTANT       holding the keys is exported through the
ASSISTANT       'LITE_LLM_USERS_DIR' environmental variable, which
ASSISTANT       is read by the custom authenticator.
ASSISTANT     4. Launch litellm with the settings specified by
ASSISTANT       the config coming from the 'lite-llm' value.
ASSISTANT       The structure of this object is specified
ASSISTANT       in the ./config.nix file.
ASSISTANT   */
ASSISTANT   launch-lite-llm = pkgs.writeScript "launch-${lite-llm-name}" ''
ASSISTANT     #!${pkgs.bash}/bin/bash
ASSISTANT     set -e
ASSISTANT 
ASSISTANT     source "${devtools-prelude.get-config lite-llm-name}"
ASSISTANT 
ASSISTANT     ${api-key-setup}
ASSISTANT 
ASSISTANT     ${users-setup}
ASSISTANT 
ASSISTANT     exec ${litellm}/bin/litellm \
ASSISTANT       --config "${lite-llm-config-dir}/config.yml" \
ASSISTANT       --port "${toString lite-llm.port}"
ASSISTANT   '';
ASSISTANT 
ASSISTANT in
ASSISTANT {
ASSISTANT   config.apps."devtools/${lite-llm-name}" = {
ASSISTANT     type = "app";
ASSISTANT     program = "${launch-lite-llm}";
ASSISTANT   };
ASSISTANT }
ASSISTANT ```
