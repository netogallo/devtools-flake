USER ```
USER """
USER Example custom auth function.
USER 
USER This will allow all keys starting with "my-custom-key" to pass through.
USER """
USER 
USER from typing import Union
USER 
USER from fastapi import Request
USER 
USER from litellm.proxy._types import UserAPIKeyAuth, ProxyException
USER 
USER 
USER async def user_api_key_auth(
USER     request: Request, api_key: str
USER ) -> Union[UserAPIKeyAuth, str]:
USER     try:
USER         if api_key.startswith("my-custom-key"):
USER             return "sk-P1zJMdsqCPNN54alZd_ETw"
USER         if api_key == "invalid-api-key":
USER             # raise a custom exception back to the client
USER             raise ProxyException(
USER                 message="Invalid API key",
USER                 type="invalid_request_error",
USER                 param="api_key",
USER                 code=401,
USER             )
USER         else:
USER             raise Exception("Invalid API key")
USER     except Exception:
